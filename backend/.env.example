# Backend environment configuration
# Copy this file to backend/.env and fill in real values.

# Database connection
# For local development, use SQLite if you do not have a MySQL password:
# DATABASE_URL=sqlite:///sp_core.db
DATABASE_URL=mysql+pymysql://sp_user:your_db_password@localhost/sp_core
# or set the MySQL-specific pieces:
MYSQL_USER=sp_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_DB=sp_core

# JWT secret for signing access tokens
SECRET_KEY=replace-with-a-secure-random-secret

# Fernet key for encrypting sensitive DB fields
DB_ENCRYPTION_KEY=LlNQzthA-870JpcYQGJRnrWr3UdsZCYO6ebr0_jCHYs=

# Enable HTTPS redirect in FastAPI when deployed behind TLS
ENFORCE_HTTPS=false

# Optional trusted hosts list for deployment
TRUSTED_HOSTS=example.com,api.example.com
